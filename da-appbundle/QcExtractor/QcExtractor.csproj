<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2024 = .NET Framework 4.8 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>QcExtractor</RootNamespace>
    <AssemblyName>QcExtractor</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Chemin de l'API Revit 2024 (surchargez avec -p:RevitApiDir=... si besoin) -->
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit 2024</RevitApiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fournie par le moteur DA / l'installation Revit : ne pas embarquer dans le bundle -->
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bridge Design Automation for Revit (DesignAutomationFramework) : embarqué dans le bundle -->
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2024.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
