<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration pour Azure App Service avec IIS/iisnode
-->
<configuration>
  <system.webServer>
    <!-- Indique que notre application Node.js est le handler -->
    <handlers>
      <add name="iisnode" path="backend/src/server.js" verb="*" modules="iisnode"/>
    </handlers>
    
    <!-- Règles de réécriture pour router toutes les requêtes vers Node.js -->
    <rewrite>
      <rules>
        <!-- Ne pas réécrire les requêtes pour les fichiers statiques existants -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}"/>
        </rule>
        
        <!-- Router toutes les autres requêtes vers Node.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <action type="Rewrite" url="backend/src/server.js"/>
        </rule>
      </rules>
    </rewrite>
    
    <!-- Configuration de sécurité -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
    
    <!-- Assurer que les erreurs Node.js sont affichées -->
    <httpErrors existingResponse="PassThrough"/>
    
    <!-- Configuration iisnode -->
    <iisnode
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
    />
  </system.webServer>
</configuration>

